# ─── Database ──────────────────────────────────────────────
# Required; "postgres" and empty are refused. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Postgres only reads it when the volume is first created; to change it later see README.
POSTGRES_PASSWORD=

# ─── Backend ───────────────────────────────────────────────
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Only reported by GET /api/health.
ENVIRONMENT=production
# Set true to log every SQL statement with its parameters (debugging only).
SQL_ECHO=false
# Application log level: DEBUG, INFO, WARNING, ERROR (request log: one line per request).
LOG_LEVEL=INFO

# ─── AI (Google Gemini) ────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model name; leave as is unless you want a different Gemini model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Rate limiting reads the client address from the last X-Forwarded-For entry
# (set by the bundled nginx). Keep true with docker compose; set false when
# the backend is reached directly, without a proxy in front.
TRUST_PROXY_HEADERS=true

# The refresh token is an httpOnly cookie marked Secure. Browsers accept that on
# https and on http://localhost; set false only when serving plain http on a LAN address.
COOKIE_SECURE=true

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Rate limits and token lifetimes (all optional; defaults shown) ────────
# docker-compose.yml passes these through to the backend.
#RATE_LIMIT_ENABLED=true
#AI_RATE_LIMIT_PER_MINUTE=10
#AUTH_RATE_LIMIT_PER_MINUTE=20
#REFRESH_RATE_LIMIT_PER_MINUTE=120
#LOGIN_MAX_FAILURES=5
#LOGIN_FAILURE_WINDOW_SECONDS=900
#ACCESS_TOKEN_EXPIRE_MINUTES=30
#REFRESH_TOKEN_EXPIRE_DAYS=7
# A rotated refresh token is accepted again for this long (two tabs refreshing at once).
#REFRESH_REUSE_GRACE_SECONDS=10

# ─── Risk analysis ─────────────────────────────────────────
# Annual risk-free rate the Sharpe ratio is measured against, as a decimal: 0.40 means 40 %.
# 0.40 is a Turkish-lira level (deposit/policy rate); lower it for a USD portfolio (roughly 0.04).
# It applies to every portfolio, whatever its currency. Check it against current rates now and then.
#RISK_FREE_RATE=0.40

# ─── Price alerts ──────────────────────────────────────────
# Seconds between background checks of every pending alert; 0 turns them off.
# Quotes are cached for 60 s, so a shorter interval does not mean fresher prices.
#ALERT_CHECK_INTERVAL_SECONDS=60
# Days after which READ notifications are deleted by that background cycle (unread ones are kept);
# 0 keeps everything. Users can also delete a notification from the bell.
#NOTIFICATION_RETENTION_DAYS=30
